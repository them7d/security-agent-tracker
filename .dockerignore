# Version control
.git
.gitignore
.gitattributes

# Dependencies (will be re-installed inside the image)
node_modules

# Next.js build output (will be rebuilt inside the image)
.next
out
build
dist

# Logs
*.log
dev.log
server.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env files (the container reads env from docker-compose / runtime env)
.env
.env.*
!.env.example

# Docker files themselves
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml

# IDE / OS
.vscode
.idea
.DS_Store
*.swp

# Project-specific scratch
download/
upload/
tests/
skills/
.zscripts/
*.tar

# Prisma local SQLite (we use Postgres in the container)
db/

# Misc
README.md
*.md
!prisma/seed.ts
